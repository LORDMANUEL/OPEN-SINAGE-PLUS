# Open Signage Plus V2
PORT=3000
OPEN_SIGNAGE_DATA_DIR=/data

# Administración (el instalador genera password/secret seguros automáticamente)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ReplaceWithStrongPassword12Plus
SESSION_SECRET=ReplaceWithRandomSecretAtLeast32Chars
SESSION_TTL_SECONDS=28800

# Xibo API
XIBO_BASE_URL=http://cms-web
XIBO_CLIENT_ID=replace_after_creating_xibo_application
XIBO_CLIENT_SECRET=replace_after_creating_xibo_application
XIBO_TIMEOUT_MS=10000

# Xibo Docker 4.5.0. El panel nativo queda ligado a loopback por defecto.
# Cambiar a 0.0.0.0 solo de forma deliberada y detrás de firewall/TLS.
XIBO_ADMIN_BIND=127.0.0.1
MYSQL_PASSWORD=ChangeThisAlphaNum16
CMS_SERVER_NAME=localhost

# IA opcional. Dejar vacío si no se usará todavía.
# Local: AI_PROVIDER=ollama, AI_BASE_URL=http://ollama:11434, AI_MODEL=qwen2.5:1.5b
# API compatible: AI_PROVIDER=compatible, AI_BASE_URL=https://proveedor/v1, AI_MODEL=..., AI_API_KEY=...
AI_PROVIDER=
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=
AI_TIMEOUT_MS=60000

# QR local mediante QuickChart del stack.
QUICKCHART_BASE_URL=http://cms-quickchart:3400
QR_TIMEOUT_MS=10000

# Browser app normalmente usa /api same-origin mediante nginx.
VITE_API_BASE_URL=
