# Open Signage Plus 2.1 Production
PORT=3000
OPEN_SIGNAGE_DATA_DIR=/data

# Administración bootstrap. install.sh genera valores seguros.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ReplaceWithStrongPassword12Plus
SESSION_SECRET=ReplaceWithRandomSecretAtLeast32Chars
SESSION_TTL_SECONDS=28800

# Seguridad HTTP. Vacío = solo same-origin; separar múltiples orígenes con coma.
CORS_ORIGINS=
TRUST_PROXY=loopback, linklocal, uniquelocal

# Dominio/TLS opcional con docker-compose.tls.yml + Caddy.
DOMAIN=signage.example.com
# Cuando TLS está activo, ligar el puerto 8080 a loopback evita exponer HTTP directo.
WEB_BIND=127.0.0.1

# Xibo API
XIBO_BASE_URL=http://cms-web
XIBO_CLIENT_ID=replace_after_creating_xibo_application
XIBO_CLIENT_SECRET=replace_after_creating_xibo_application
XIBO_TIMEOUT_MS=10000

# Xibo Docker 4.5.x. Panel nativo ligado a loopback por defecto.
XIBO_ADMIN_BIND=127.0.0.1
MYSQL_PASSWORD=ChangeThisAlphaNum16
CMS_SERVER_NAME=localhost

# IA primaria
AI_PROVIDER=
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=
AI_TIMEOUT_MS=60000

# IA fallback opcional. Ejemplo: local primero y nube como fallback.
AI_FALLBACK_PROVIDER=
AI_FALLBACK_BASE_URL=
AI_FALLBACK_MODEL=
AI_FALLBACK_API_KEY=
AI_FALLBACK_TIMEOUT_MS=60000

# QR local
QUICKCHART_BASE_URL=http://cms-quickchart:3400
QR_TIMEOUT_MS=10000

# Alertas. Webhook puede apuntar a Slack/Teams/Discord mediante adaptador propio.
ALERT_WEBHOOK_URL=
# Correo de alertas usa SMTPS (TLS directo, normalmente puerto 465).
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
ALERT_EMAIL_TO=
MONITOR_INTERVAL_MS=60000
ALERT_COOLDOWN_MS=900000

# Salud operacional P0.
DISK_FREE_WARN_PERCENT=10
BACKUP_MAX_AGE_HOURS=30
TLS_EXPIRY_WARN_DAYS=21

# Backups
BACKUP_ROOT=shared/backups
RETENTION_DAYS=14

# Browser app normalmente usa /api same-origin mediante nginx.
VITE_API_BASE_URL=
