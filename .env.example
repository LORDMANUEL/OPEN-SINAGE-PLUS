# Open Signage Plus V2
PORT=3000
XIBO_BASE_URL=http://cms-web
XIBO_CLIENT_ID=replace_after_creating_xibo_application
XIBO_CLIENT_SECRET=replace_after_creating_xibo_application
XIBO_TIMEOUT_MS=10000

# Xibo Docker 4.5.0
# Use only A-Z a-z 0-9, around 16 chars, matching Xibo's official recommendation.
MYSQL_PASSWORD=ChangeThisAlphaNum16
CMS_SERVER_NAME=localhost

# Browser app normally uses same-origin /api via nginx.
VITE_API_BASE_URL=
